<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" version="1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://gexf.net/1.3 http://gexf.net/1.3/gexf.xsd">
    <graph defaultedgetype="directed" timeformat="double" timerepresentation="timestamp" timezone="UTC" mode="dynamic">
        <attributes class="node" mode="static">
            <attribute id="events" title="events" type="string"></attribute>
        </attributes>
        <nodes>
            <node id="1">
                <attvalues>
                    <attvalue for="events" value="&lt;[3.0]&gt;"/>
                </attvalues>
            </node>
            <node id="2">
                <attvalues>
                    <attvalue for="events" value="&lt;[6.0]&gt;"/>
                </attvalues>
            </node>
        </nodes>
        <edges>
            <edge id="1" source="1" target="2"></edge>
        </edges>
    </graph>
</gexf>